{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "standing_tier": {
      "type": "string",
      "enum": [
        "Safety tier",
        "Likely tier",
        "Reach tier",
        "High reach tier",
        "Not enough info"
      ]
    },
    "standing_summary": {
      "type": "string"
    },
    "priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      }
    },
    "dont_bother": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "completeness_percent": {
      "type": "number"
    },
    "missing_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}